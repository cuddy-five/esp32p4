# Copy to .env and source it, or export the variables directly. .env is gitignored.

# GitHub token used by `control-plane settings ...`. Resolution order:
# GH_TOKEN, GITHUB_TOKEN, then `gh auth token`.
#   plan/check:        Metadata: read
#   apply labels:      Issues: write
#   apply rulesets:    Administration: write
GH_TOKEN=

# Default target repository (owner/name). Falls back to GITHUB_REPOSITORY, then
# the `origin` remote of the current checkout. Override per call with --repo.
GH_REPO=

# GitHub Enterprise Server: REST API base URL. Defaults to https://api.github.com.
# GITHUB_API_URL=https://github.example.com/api/v3

# Print stack traces on CLI errors.
# CONTROL_PLANE_DEBUG=1
