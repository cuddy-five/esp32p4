{
  "schema_version": 1,
  "agents": [
    {
      "id": "planner",
      "name": "Planner",
      "description": "Choose when the request asks to design, architect, or write a step-by-step plan with tests and rollback before changing code, or when the request is vague. Not for writing code or reviewing.",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 5000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 2
      },
      "scope": {
        "allowed_paths": [
          ".github/control-plane/**",
          "docs/**",
          ".runtime/**"
        ],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/dist/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**"
        ],
        "min_approval_level": "maintainer"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "implementer",
      "name": "Implementer",
      "description": "Choose when the request is to write, fix, refactor, test, or document code or build errors (plan approval is enforced separately). Not for writing a plan, reviewing code, or re-verifying finished work.",
      "model": "gpt-6-luna",
      "reasoning_effort": "medium",
      "budget": {
        "max_ai_credits": 8000,
        "max_tokens_per_request": 16000,
        "max_concurrent_tasks": 3
      },
      "scope": {
        "allowed_paths": [
          "src/**",
          "tests/**",
          "docs/**",
          "*.md"
        ],
        "forbidden_paths": [
          ".env*",
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          "src/lib/**",
          "tests/**"
        ],
        "min_approval_level": "reviewer"
      },
      "timeout_ms": 600000,
      "enabled": true
    },
    {
      "id": "reviewer",
      "name": "Reviewer",
      "description": "Choose when existing code, SQL migrations, style, or a written plan must be inspected for bugs, quality, or design flaws. Not for merge-readiness gate checks, security audits, or writing code.",
      "model": "kimi-k3",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 4000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 1
      },
      "scope": {
        "allowed_paths": [],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/dist/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**",
          ".github/agents/**"
        ],
        "min_approval_level": "owner"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "security_auditor",
      "name": "Security Auditor",
      "description": "Choose when the request involves secrets, credentials, auth, input handling, untrusted data, dependencies or any attack surface, or asks for a security check. Not for general code quality.",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 4000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 1
      },
      "scope": {
        "allowed_paths": [],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for": "any_risk_medium_or_above",
        "min_approval_level": "owner"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "verifier",
      "name": "Verifier",
      "description": "Choose when the request is to independently re-run tests, verify acceptance criteria, or check whether a pull request with passing reviews is ready to merge. Not for code review or writing code.",
      "model": "claude-haiku-4.5",
      "reasoning_effort": "medium",
      "budget": {
        "max_ai_credits": 2000,
        "max_tokens_per_request": 4000,
        "max_concurrent_tasks": 2
      },
      "scope": {
        "allowed_paths": [],
        "forbidden_paths": [
          ".env*",
          ".github/control-plane/**",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [],
        "min_approval_level": "none"
      },
      "timeout_ms": 180000,
      "enabled": true
    }
  ]
}