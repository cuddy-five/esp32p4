{
  "schema_version": 1,
  "agents": [
    {
      "id": "planner",
      "name": "Planner",
      "description": "Choose when the work needs a step-by-step plan with tests and rollback before any code changes, or the request is vague or large. Not for writing code or judging finished work.",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 5000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 2
      },
      "scope": {
        "allowed_paths": [
          ".github/control-plane/**",
          "docs/**",
          "src/**",
          "tests/**"
        ],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/dist/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**"
        ],
        "min_approval_level": "maintainer"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "implementer",
      "name": "Implementer",
      "description": "Choose when an approved plan exists and the request is to make the code, test or doc changes inside its scope. Not for planning, reviewing or verifying its own work.",
      "model": "gpt-6-luna",
      "reasoning_effort": "medium",
      "budget": {
        "max_ai_credits": 8000,
        "max_tokens_per_request": 16000,
        "max_concurrent_tasks": 3
      },
      "scope": {
        "allowed_paths": [
          "src/**",
          "tests/**",
          "docs/**"
        ],
        "forbidden_paths": [
          ".env*",
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          "src/lib/**",
          "tests/**"
        ],
        "min_approval_level": "reviewer"
      },
      "timeout_ms": 600000,
      "enabled": true
    },
    {
      "id": "reviewer",
      "name": "Reviewer",
      "description": "Choose when a plan or a finished change must be judged for reasons not to merge. Not for writing the change, planning it, or re-running its tests.",
      "model": "kimi-k3",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 4000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 1
      },
      "scope": {
        "allowed_paths": [],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/dist/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [
          ".github/control-plane/**",
          ".github/workflows/**",
          ".github/actions/**",
          ".github/agents/**"
        ],
        "min_approval_level": "owner"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "security_auditor",
      "name": "Security Auditor",
      "description": "Choose when the request involves secrets, credentials, auth, input handling, untrusted data, dependencies or any attack surface, or asks for a security check. Not for general code quality.",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "high",
      "budget": {
        "max_ai_credits": 4000,
        "max_tokens_per_request": 8000,
        "max_concurrent_tasks": 1
      },
      "scope": {
        "allowed_paths": [
          "src/**",
          "tests/**",
          ".github/workflows/**"
        ],
        "forbidden_paths": [
          ".env*",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for": "any_risk_medium_or_above",
        "min_approval_level": "owner"
      },
      "timeout_ms": 300000,
      "enabled": true
    },
    {
      "id": "verifier",
      "name": "Verifier",
      "description": "Choose when the request is to independently re-run tests or re-check that finished work really meets its acceptance criteria. Not for writing the change or for opinions on design.",
      "model": "claude-haiku-4.5",
      "reasoning_effort": "medium",
      "budget": {
        "max_ai_credits": 2000,
        "max_tokens_per_request": 4000,
        "max_concurrent_tasks": 2
      },
      "scope": {
        "allowed_paths": [
          "tests/**",
          "src/**"
        ],
        "forbidden_paths": [
          ".env*",
          ".github/control-plane/**",
          "**/node_modules/**",
          "**/.git/**"
        ]
      },
      "approval_rules": {
        "requires_approval_for_paths": [],
        "min_approval_level": "none"
      },
      "timeout_ms": 180000,
      "enabled": true
    }
  ]
}
